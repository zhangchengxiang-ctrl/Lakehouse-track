# ============================================================
# Lakehouse-track 环境变量（复制为 .env 后按需修改）
# docker compose 会自动加载 .env；脚本/应用从容器环境继承
# ============================================================

# ---------- 1. PostgreSQL ----------
# 应用连接：MetaAPI、meta_sync、Flink CDC 等；postgres 容器由 docker-compose 从 PG_* 映射初始化
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=postgres
# 业务 schema；连接后设置 search_path，应用内 SQL 无需写 stellar_trace. 前缀
PG_SCHEMA=stellar_trace
# meta-api 连接池最大连接数
PG_POOL_MAX=20
# Hive Metastore 使用的数据库名（与业务库 PG_DB 分离）
HMS_DB=metastore

# ---------- 2. Collection / 元数据同步 ----------
# collection 节点暴露的宿主机端口（单节点默认 8080，多节点用 "8080-808N" 格式）
COLLECTION_PORT=8080
# collection 内 Vector 调用本地 meta-api 的注册地址
META_API_URL=http://127.0.0.1:3000/register
# meta_sync 轮询 meta-api 并写入 Vector 的间隔（秒）
META_SYNC_INTERVAL=30
# Vector 日志级别：trace / debug / info / warn / error
VECTOR_LOG=info
# 部署环境：dev=开发(事件时间取 Nginx 采集时间)，pro=生产(优先 SDK 上报时间)
DEPLOY_ENV=dev

# ---------- 3. MinIO / S3 对象存储 ----------
# MinIO 管理员凭证 & 各组件（Vector、Flink、StarRocks 等）的 S3 访问凭证
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lakehouse
S3_REGION=us-east-1
